generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model DataItem {
  id          String    @id @default(cuid())
  key         String    @unique
  label       String
  description String
  category    String
  domain      String
  defaultValue String?
  mappings    Mapping[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Framework {
  id       String    @id @default(cuid())
  name     String    @unique
  version  String
  region   String
  controls Control[]
}

model Control {
  id          String         @id @default(cuid())
  frameworkId String
  framework   Framework      @relation(fields: [frameworkId], references: [id])
  ref         String
  theme       String
  description String
  mappings    Mapping[]
  scopeMappings ScopeMapping[]
}

model Mapping {
  id               String    @id @default(cuid())
  dataItemId       String
  dataItem         DataItem  @relation(fields: [dataItemId], references: [id])
  controlId        String
  control          Control   @relation(fields: [controlId], references: [id])
  justification    String
  severity         String
  slaThreshold     String
  findingType      String
  remediation      String
  evidenceRequired String
  region           String
  supplyChainFlag  Boolean   @default(false)
  kevOverride      String    @default("N/A")
  testId           String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([dataItemId, controlId])
}

model Scope {
  id                String         @id @default(cuid())
  provider          String
  scopeId           String
  displayName       String
  description       String
  category          String
  adminConsentRequired Boolean @default(false)
  accessLevel       String         @default("read")
  mappings          ScopeMapping[]
  createdAt         DateTime       @default(now())

  @@unique([provider, scopeId])
}

model ScopeMapping {
  id          String   @id @default(cuid())
  scopeId     String
  scope       Scope    @relation(fields: [scopeId], references: [id])
  controlId   String
  control     Control  @relation(fields: [controlId], references: [id])
  justification String
  riskLevel   String   @default("medium")
  createdAt   DateTime @default(now())

  @@unique([scopeId, controlId])
}
